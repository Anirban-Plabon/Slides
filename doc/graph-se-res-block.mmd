flowchart TD
    X("X (Cin)") --> C1("Conv3D 3×3×3 + BN + ReLU") --> C2("Conv3D 3×3×3 + BN") 
    C2 --> H("H")

    H --> Pool("Grid AvgPool<br/>V ← pool(H), stride s")
    Pool --> GAT("Graph Attention<br/>single-head GAT — 'squeeze'")
    GAT --> Excite("Linear + Sigmoid<br/>g = σ(Linear(V')) — 'excite'")
    Excite --> Interp("Interpolate<br/>g → H resolution")

    H --> Mult(("⊙"))
    Interp --> Mult
    Mult --> Add(("+"))

    X --> Shortcut("Shortcut 𝒫(X)<br/>1×1×1 Conv + BN")
    Shortcut --> Add

    Add --> ReLU2("ReLU") --> Y("Y (Cout)")